# พอร์ตของ Server (ค่าเริ่มต้น 3000)
PORT=3000
NODE_ENV=development

# CORS: origin ของ frontend ที่เรียก API ข้ามพอร์ต คั่นหลายค่าด้วย ,
# ถ้าเว้นว่าง ระบบจะอนุญาต http://127.0.0.1:5500 และ http://localhost:5500 (Live Server)
ALLOWED_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000

# ฐานข้อมูล MySQL (พอร์ต 3307 ตรงกับ docker-compose.yml)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=ใส่รหัสผ่านที่ต้องการที่นี่ (ต้องตรงกับที่ใช้ตอน docker compose up)
DB_NAME=boardgame_db

# External API (แจ้งเตือนผ่าน ntfy.sh) - ไม่บังคับ
NOTIFY_URL=https://ntfy.sh
NOTIFY_TOPIC=boardgames-notification
EXTERNAL_TIMEOUT_MS=2000
EXTERNAL_MAX_RETRIES=2
EXTERNAL_RETRY_DELAY_MS=300
