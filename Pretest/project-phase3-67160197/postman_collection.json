              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "[201] Create Borrowing (Borrow Available Game)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": 3,\n  \"boardgameId\": 1,\n  \"borrowDate\": \"2026-10-12\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/v1/borrowings",
              "host": ["http://localhost:3000"],
              "path": ["api", "v1", "borrowings"]
            },
            "description": "ยืมบอร์ดเกม ID 1 (Catan) ซึ่งปัจจุบันสถานะคืนแล้ว (ว่างให้ยืม)"
          }
        },
        {
          "name": "[200] Return Boardgame (Return Borrowed Game)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"returnDate\": \"2026-10-15\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/v1/borrowings/:id/return",
              "host": ["http://localhost:3000"],
              "path": ["api", "v1", "borrowings", ":id", "return"],
