    {
      "name": "1. Boardgames - Success Cases",
      "item": [
        {
          "name": "[200] Get All Boardgames",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/boardgames",
              "host": ["http://localhost:3000"],
              "path": ["api", "v1", "boardgames"]
            }
          }
        },
        {
          "name": "[200] Search Boardgames by Players",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/boardgames?players=4",
              "host": ["http://localhost:3000"],
              "path": ["api", "v1", "boardgames"],
              "query": [{ "key": "players", "value": "4" }]
